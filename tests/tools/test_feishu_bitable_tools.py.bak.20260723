PROJECT_MEETING_TEXT = """Maison：Celine
Project：Voice Tagging

Meeting Notes：
标签逻辑已完成调整，目前等待业务团队复核。Jiayao负责跟进复核结果，Mars负责确认CRM写入权限。

Risk：
业务团队复核可能延迟，Jiayao需要持续跟进。

最新进展记录：
标签逻辑已完成调整，正在等待业务团队复核及CRM权限确认。

Action Items：
1. 跟进业务团队完成复核｜Jiayao｜2026/07/24｜Pending
2. 确认CRM写入权限｜Mars｜2026/07/25｜Pending
"""


def _prepare_project_meeting(**kwargs):
    args = {
        "base_url": BASE_URL,
        "raw_text": PROJECT_MEETING_TEXT,
        "meeting_date": "2026-07-20",
        "user_id": "ou_1",
        "chat_id": "oc_1",
        "session_id": "sess_1",
    }
    args.update(kwargs)
    return bt.bitable_prepare_project_meeting_write(**args)


def test_project_meeting_preview_has_no_user_facing_change_id(monkeypatch, tmp_path):
