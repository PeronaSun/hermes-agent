    preview = _prepare_project_meeting()
    visible = _visible_json(preview)
    assert preview["success"] is True
    assert "fbm_" not in visible
    assert "fbmp_" not in visible
    assert "change_id" not in preview
    assert preview["user_message"].endswith("是否确认写入飞书？请回复：确认")
    assert not [call for call in calls if call["method"] in {"POST", "PUT"}]


