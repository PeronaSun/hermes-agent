    assert stored["tbl_action"][-1]["fields"]["Project"] == ["real"]
    assert "业务团队复核可能延迟" in stored["tbl_project"][1]["fields"]["Risk"]


def test_project_meeting_empty_primary_field_is_filled(monkeypatch, tmp_path):
    _pending_in_tmp(monkeypatch, tmp_path)
