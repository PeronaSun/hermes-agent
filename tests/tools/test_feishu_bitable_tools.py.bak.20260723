def test_update_tools_registered():
    for name in (
        "feishu_bitable_prepare_record_update",
        "feishu_bitable_apply_record_update",
        "feishu_bitable_prepare_meeting_write",
        "feishu_bitable_apply_meeting_write",
        "feishu_bitable_prepare_project_meeting_write",
        "feishu_bitable_apply_project_meeting_write",
    ):
        entry = registry.get_entry(name)
        assert entry is not None
        assert entry.toolset == "feishu_bitable"


