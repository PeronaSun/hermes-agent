    assert stored["tbl_project"][0]["fields"]["Risk"] == risk


def test_project_meeting_repeated_confirmation_and_resend_do_not_duplicate(monkeypatch, tmp_path):
    _pending_in_tmp(monkeypatch, tmp_path)
    _, stored = _install_fake_meeting_workflow(monkeypatch)
    _prepare_project_meeting()
    bt.bitable_apply_project_meeting_write(confirmation_text="确认", user_id="ou_1", chat_id="oc_1", session_id="sess_1")
    again = bt.bitable_apply_project_meeting_write(confirmation_text="确认", user_id="ou_1", chat_id="oc_1", session_id="sess_1")
    resent = _prepare_project_meeting()
    assert again["already_applied"] is True
    assert resent["already_applied"] is True
    assert len(stored["tbl_meeting"]) == 1
    assert len(stored["tbl_action"]) == 3


def test_project_meeting_partial_failure_retry_reuses_meeting(monkeypatch, tmp_path):
    _pending_in_tmp(monkeypatch, tmp_path)
    calls, stored = _install_fake_meeting_workflow(monkeypatch, fail_action_create_once=True)
    _prepare_project_meeting()
    out = json.loads(bt._handler(bt._apply_project_meeting_write_handler)({
        "confirmation_text": "确认",
        "user_id": "ou_1",
        "chat_id": "oc_1",
        "session_id": "sess_1",
    }))
    assert "temporary create failure" in out["error"]
    assert len(stored["tbl_meeting"]) == 1
    retry = bt.bitable_apply_project_meeting_write(confirmation_text="确认", user_id="ou_1", chat_id="oc_1", session_id="sess_1")
    assert retry["success"] is True
    assert len([call for call in calls if call["method"] == "POST" and call["paths"]["table_id"] == "tbl_meeting"]) == 1


def test_project_meeting_missing_field_returns_specific_error(monkeypatch, tmp_path):
    _pending_in_tmp(monkeypatch, tmp_path)
    _install_fake_meeting_workflow(monkeypatch)
    original = bt.bitable_list_fields

    def missing_owner(app_token, table_id, view_id=""):
        fields = original(app_token, table_id, view_id)
        if table_id == "tbl_action":
            return [field for field in fields if field["field_name"] != "Owner"]
        return fields

    monkeypatch.setattr(bt, "bitable_list_fields", missing_owner)
    out = json.loads(bt._handler(bt._prepare_project_meeting_write_handler)({
        "base_url": BASE_URL,
        "raw_text": PROJECT_MEETING_TEXT,
        "meeting_date": "2026-07-20",
    }))
    assert "Action Items 缺少必需字段：Owner" in out["error"]
    assert "请手动填写" not in out["error"]
    assert "API不支持新建记录" not in out["error"]
