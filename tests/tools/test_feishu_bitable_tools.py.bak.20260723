def _install_fake_bitable(monkeypatch, *, permission_code=0, empty_records=False, update_permission_code=0, records=None):
    calls = []
    stored_records = records or _fake_records()
    bt.set_client(object())

    def fake_do_request(client, method, uri, paths=None, queries=None, body=None):
        calls.append({"method": method, "uri": uri, "paths": paths or {}, "queries": queries or [], "body": body})
        if permission_code:
            return permission_code, "forbidden", {}
        if uri == bt._RECORD_URI:
            if update_permission_code:
                return update_permission_code, "missing scope base:record:update", {}
            record_id = paths["record_id"]
            for record in stored_records:
                if record["record_id"] == record_id:
                    record.setdefault("fields", {}).update((body or {}).get("fields", {}))
                    return 0, "", {"record": record}
            return 1254040, "not found", {}
        if uri == bt._APP_URI:
            return 0, "", {"app": {"name": "Roadmap Base", "app_token": paths["app_token"]}}
        if uri == bt._TABLES_URI:
            return 0, "", {"items": [
                {"table_id": "tbl_other", "name": "Other", "revision": 1},
                {"table_id": "tblsJ9hnV1u9ulX1", "name": "Project Tracking", "revision": 2},
            ]}
        if uri == bt._VIEWS_URI:
            return 0, "", {"items": [
                {"view_id": "vew_all", "view_name": "All Tasks", "view_type": "grid"},
                {"view_id": "vewXxBNTOK", "view_name": "Project Tracking", "view_type": "grid"},
            ]}
        if uri == bt._FIELDS_URI:
            return 0, "", {"items": _fake_fields()}
        if uri == bt._RECORDS_URI:
            if empty_records:
                return 0, "", {"items": []}
            page_token = dict(queries or []).get("page_token", "")
            if page_token:
                return 0, "", {"items": stored_records[2:], "has_more": False}
            return 0, "", {"items": stored_records[:2], "has_more": True, "page_token": "next"}
        raise AssertionError(f"unexpected request {method} {uri}")

    monkeypatch.setattr(bt, "_do_request", fake_do_request)
    return calls, stored_records


def _pending_in_tmp(monkeypatch, tmp_path):
    monkeypatch.setattr(bt, "_pending_dir", lambda: Path(tmp_path))


def _meeting_workflow_fields(table_id, *, include_date_field=False):
    if table_id == "tbl_project":
        fields = [
            {"field_id": "fld_project", "field_name": "Task", "type": 1, "property": {}},
            {"field_id": "fld_desc_primary", "field_name": "任务描述", "type": 1, "property": {}, "is_primary": True},
            {"field_id": "fld_maison", "field_name": "Maison", "type": 1, "property": {}},
            *([{"field_id": "fld_20jul", "field_name": "20-Jul", "type": 1, "property": {}}] if include_date_field else []),
            {"field_id": "fld_group", "field_name": "分组", "type": 1, "property": {}},
            {"field_id": "fld_status", "field_name": "Status", "type": 3, "property": {"options": [{"name": "In Progress"}]}},
            {"field_id": "fld_risk", "field_name": "Risk", "type": 1, "property": {}},
            {"field_id": "fld_progress", "field_name": "最新进展记录", "type": 1, "property": {}},
            {"field_id": "fld_meeting_records", "field_name": "Meeting Records", "type": 21, "property": {"table_id": "tbl_meeting"}},
            {"field_id": "fld_action_items", "field_name": "Action Items", "type": 21, "property": {"table_id": "tbl_action"}},
        ]
        return fields
    if table_id == "tbl_meeting":
        return [
            {"field_id": "fld_title", "field_name": "Title", "type": 1, "property": {}, "is_primary": True},
            {"field_id": "fld_date", "field_name": "Meeting Date", "type": 5, "property": {}},
            {"field_id": "fld_project_link", "field_name": "Project", "type": 21, "property": {"table_id": "tbl_project"}},
            {"field_id": "fld_maison", "field_name": "Maison", "type": 3, "property": {"options": [{"name": "Celine"}]}},
            {"field_id": "fld_notes", "field_name": "Meeting Notes", "type": 1, "property": {}},
            {"field_id": "fld_ai_summary", "field_name": "AI Summary", "type": 1, "property": {}},
            {"field_id": "fld_ai_actions", "field_name": "AI Action Items", "type": 1, "property": {}},
            {"field_id": "fld_status", "field_name": "Status", "type": 3, "property": {"options": [{"name": "Completed"}]}},
            {"field_id": "fld_fingerprint", "field_name": "Source Fingerprint", "type": 1, "property": {}},
        ]
    return [
        {"field_id": "fld_task1", "field_name": "Task1", "type": 1, "property": {}, "is_primary": True},
        {"field_id": "fld_project_link", "field_name": "Project", "type": 21, "property": {"table_id": "tbl_project"}},
        {"field_id": "fld_maison_select", "field_name": "Maison", "type": 3, "property": {"options": [{"name": "Celine"}]}},
        {"field_id": "fld_owner", "field_name": "Owner", "type": 1, "property": {}},
        {"field_id": "fld_deadline", "field_name": "Deadline", "type": 5, "property": {}},
        {"field_id": "fld_status", "field_name": "Status", "type": 3, "property": {"options": [{"name": "Pending"}]}},
        {"field_id": "fld_priority", "field_name": "Priority", "type": 3, "property": {"options": [{"name": "Medium"}]}},
        {"field_id": "fld_source_meeting", "field_name": "Source Meeting", "type": 21, "property": {"table_id": "tbl_meeting"}},
    ]


def _install_fake_meeting_workflow(
    monkeypatch,
    *,
    create_failure=False,
    fail_action_create_once=False,
    update_failure=False,
    existing_date_field=False,
    readonly_meeting_maison=False,
    project_records=None,
):
    calls = []
    bt.set_client(object())
    stored = {
        "tbl_project": [
            {
                "record_id": "recvoRMi4iGbfg",
                "fields": {
                    "Task": "Celine",
                    "任务描述": "Celine Voice Tagging",
                    "Maison": "Celine",
                    "分组": "Voice Tagging",
                    "最新进展记录": "old",
                    "Meeting Records": [],
                    "Action Items": [],
                },
            }
        ] if project_records is None else project_records,
        "tbl_meeting": [],
        "tbl_action": [
            {"record_id": "blank_existing", "fields": {"Task1": ""}},
        ],
    }
    counters = {"tbl_meeting": 1, "tbl_action": 1}
    created_fields = {"tbl_project": []}
    failures = {"action_create": bool(fail_action_create_once)}

    def fake_do_request(client, method, uri, paths=None, queries=None, body=None):
        calls.append({"method": method, "uri": uri, "paths": paths or {}, "queries": queries or [], "body": body})
        if uri == bt._TABLES_URI:
            return 0, "", {"items": [
                {"table_id": "tbl_project", "name": "Project Tracking"},
                {"table_id": "tbl_meeting", "name": "Meeting Records"},
                {"table_id": "tbl_action", "name": "Action Items"},
            ]}
        if uri == bt._FIELDS_URI:
            if method == "POST":
                field = {
                    "field_id": f"fld_created_{len(created_fields.setdefault(paths['table_id'], [])) + 1}",
                    "field_name": (body or {}).get("field_name"),
                    "type": (body or {}).get("type", 1),
                    "property": (body or {}).get("property", {}),
                }
                created_fields.setdefault(paths["table_id"], []).append(field)
                return 0, "", {"field": field}
            fields = [*_meeting_workflow_fields(paths["table_id"], include_date_field=existing_date_field), *created_fields.get(paths["table_id"], [])]
            if paths["table_id"] == "tbl_meeting" and readonly_meeting_maison:
                for field in fields:
                    if field.get("field_name") == "Maison":
                        field["is_readonly"] = True
            return 0, "", {"items": fields}
        if uri == bt._RECORDS_URI and method == "GET":
            return 0, "", {"items": stored.get(paths["table_id"], [])}
        if uri == bt._RECORDS_URI and method == "POST":
            if create_failure:
                return 403, "missing scope base:record:create", {}
            table_id = paths["table_id"]
            if table_id == "tbl_action" and failures["action_create"]:
                failures["action_create"] = False
                return 500, "temporary create failure", {}
            record_id = f"new_{table_id}_{counters[table_id]}"
            counters[table_id] += 1
            record = {"record_id": record_id, "fields": dict((body or {}).get("fields") or {})}
            stored[table_id].append(record)
            return 0, "", {"record": record}
        if uri == bt._RECORD_URI and method == "PUT":
            if update_failure:
                return 403, "missing scope base:record:update", {}
            for record in stored.get(paths["table_id"], []):
                if record["record_id"] == paths["record_id"]:
                    record.setdefault("fields", {}).update((body or {}).get("fields") or {})
                    return 0, "", {"record": record}
            return 1254040, "not found", {}
        raise AssertionError(f"unexpected request {method} {uri}")

    monkeypatch.setattr(bt, "_do_request", fake_do_request)
    return calls, stored


def _visible_json(value):
    return json.dumps(value, ensure_ascii=False)


def _prepare_meeting_preview(**overrides):
    kwargs = {
        "base_url": BASE_URL,
        "project": "Voice Tagging",
        "maison": "Celine",
        "meeting_notes": "Raw meeting notes: complete Follow-up Message page V2 optimization by this Friday.",
        "project_table_name": "Project Tracking",
        "project_matching_conditions": {"Task": "Celine", "分组": "Voice Tagging"},
        "project_updates": {"最新进展记录": "Follow-up page optimization discussed"},
        "meeting_record_fields": {
            "Title": "Celine Voice Tagging meeting",
            "Meeting Date": "2026-07-20",
            "Meeting Notes": "Raw meeting notes",
            "AI Summary": "Meeting Summary\nDecision: proceed.",
            "AI Action Items": "- Complete Follow-up Message page V2 optimization",
            "Status": "Completed",
        },
        "action_items": [
            {
                "Task1": "Complete Follow-up Message page V2 optimization",
                "Maison": "Celine",
                "Owner": "Perona",
                "Deadline": "本周五",
                "Status": "Pending",
                "Priority": "Medium",
            }
        ],
        "meeting_date": "2026-07-20",
    }
    kwargs.update(overrides)
    return bt.bitable_prepare_meeting_write(
        **kwargs,
    )


def test_parse_base_url():
    parsed = bt.parse_base_url(BASE_URL)
    assert parsed == {
        "app_token": "P6dGbhdMRaaD7csRCw1cR5iUnLc",
        "table_id": "tblsJ9hnV1u9ulX1",
        "view_id": "vewXxBNTOK",
    }


def test_tools_registered():
    for name in (
        "feishu_bitable_get_app",
        "feishu_bitable_list_tables",
        "feishu_bitable_list_views",
        "feishu_bitable_list_fields",
        "feishu_bitable_list_records",
        "feishu_bitable_read_table",
    ):
        entry = registry.get_entry(name)
        assert entry is not None
        assert entry.toolset == "feishu_bitable"


