"""Feishu Bitable/Base tools -- read and safely update Base tables via Feishu/Lark API."""

from __future__ import annotations

import importlib.util
import hashlib
import json
import logging
import os
import re
import threading
import time
import uuid
from datetime import date, datetime, time as datetime_time, timedelta, timezone
from pathlib import Path
from urllib.parse import parse_qs, urlparse

from hermes_constants import get_hermes_home
from tools.registry import registry, tool_error, tool_result

logger = logging.getLogger(__name__)

_local = threading.local()
_global_client = None
_client_lock = threading.Lock()
_pending_lock = threading.Lock()
_PENDING_TTL_SECONDS = 30 * 60
_READ_SCOPE_HINT = "base:record:retrieve"
_WRITE_SCOPE_HINT = "base:record:update"
_CREATE_SCOPE_HINT = "base:record:create"
_FIELD_READ_SCOPE_HINT = "base:field:retrieve"
_FIELD_CREATE_SCOPE_HINT = "base:field:create"
_APP_READ_SCOPE_HINT = "bitable:app:readonly"

_BASE_URL_RE = re.compile(r"/base/(?P<app_token>[A-Za-z0-9_-]+)")

_APP_URI = "/open-apis/bitable/v1/apps/:app_token"
_TABLES_URI = "/open-apis/bitable/v1/apps/:app_token/tables"
_VIEWS_URI = "/open-apis/bitable/v1/apps/:app_token/tables/:table_id/views"
_FIELDS_URI = "/open-apis/bitable/v1/apps/:app_token/tables/:table_id/fields"
_RECORDS_URI = "/open-apis/bitable/v1/apps/:app_token/tables/:table_id/records"
_RECORD_URI = "/open-apis/bitable/v1/apps/:app_token/tables/:table_id/records/:record_id"


def set_client(client):
    """Store the live lark SDK client for Bitable tools."""
    global _global_client
    _local.client = client
    with _client_lock:
        _global_client = client


def get_client():
    """Return the thread-local or process-global lark SDK client."""
    return getattr(_local, "client", None) or _global_client


def _check_feishu():
    try:
        return importlib.util.find_spec("lark_oapi") is not None
    except (ImportError, ValueError):
        return False


def parse_base_url(base_url: str) -> dict:
    """Extract app_token, table_id and view_id from a Feishu Base URL."""
    parsed = urlparse(str(base_url or "").strip())
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError("无效的飞书 Base URL")
    match = _BASE_URL_RE.search(parsed.path or "")
    if not match:
        raise ValueError("仅支持包含 /base/ 的飞书 Base / Bitable URL")
    query = parse_qs(parsed.query or "")
    return {
        "app_token": match.group("app_token"),
        "table_id": (query.get("table") or [""])[0],
        "view_id": (query.get("view") or [""])[0],
    }


def _response_data(response) -> dict:
    data = {}
    raw = getattr(response, "raw", None)
    if raw and hasattr(raw, "content"):
        try:
            body = json.loads(raw.content)
            data = body.get("data", {})
        except (json.JSONDecodeError, AttributeError, TypeError):
            pass
    if not data:
        resp_data = getattr(response, "data", None)
        if isinstance(resp_data, dict):
            data = resp_data
        elif resp_data and hasattr(resp_data, "__dict__"):
            data = vars(resp_data)
    return data if isinstance(data, dict) else {}


def _do_request(client, method, uri, paths=None, queries=None, body=None):
    """Build and execute a lark BaseRequest, returning (code, msg, data)."""
    from lark_oapi import AccessTokenType
    from lark_oapi.core.enum import HttpMethod
    from lark_oapi.core.model.base_request import BaseRequest

    http_method = getattr(HttpMethod, method.upper(), None)
    if http_method is None:
        http_method = {
            "GET": HttpMethod.GET,
            "POST": HttpMethod.POST,
            "PUT": HttpMethod.PUT,
            "PATCH": getattr(HttpMethod, "PATCH", HttpMethod.PUT),
            "DELETE": HttpMethod.DELETE,
        }[method.upper()]

    builder = (
        BaseRequest.builder()
        .http_method(http_method)
        .uri(uri)
        .token_types({AccessTokenType.TENANT})
    )
    if paths:
        builder = builder.paths(paths)
    if queries:
        builder = builder.queries(queries)
    if body is not None:
        builder = builder.body(body)
    response = client.request(builder.build())
    return getattr(response, "code", None), getattr(response, "msg", ""), _response_data(response)


def _missing_scope(msg: str, data: dict | None = None, fallback: str = "") -> str:
    haystack = [str(msg or "")]
    if isinstance(data, dict):
        haystack.append(json.dumps(data, ensure_ascii=False))
    pattern = re.compile(r"(?:base|bitable):[A-Za-z0-9:_-]+")
    for text in haystack:
        match = pattern.search(text)
        if match:
            return match.group(0)
    return fallback


def _raise_api_error(action: str, code, msg, *, empty_permission_hint: bool = False, data=None, required_scope: str = ""):
    if code == 0:
        return
    code_s = str(code)
    if code == 403 or code_s in {"1254003", "1254030", "1254031", "99991663", "99991672"}:
        scope = _missing_scope(msg, data, required_scope)
        suffix = f"缺少权限范围：{scope}。" if scope else "缺少多维表格权限。"
        raise PermissionError(f"{action}失败：Base 未共享给当前应用，或{suffix}")
    if code_s in {"99991400", "99991401", "99991402"}:
        raise RuntimeError(f"{action}失败：Feishu 客户端凭证或 tenant token 不可用，请重启网关后重试。")
    if code_s in {"99991403", "99991404", "99991405"}:
        raise RuntimeError(f"{action}失败：触发飞书 API 限流，请稍后重试。")
    if empty_permission_hint:
        raise PermissionError(f"{action}失败：可能受高级权限限制，接口未返回可见数据。")
    raise RuntimeError(f"{action}失败：code={code} msg={msg}")


def _items(data: dict, *keys: str) -> list:
    for key in keys:
        value = data.get(key)
        if isinstance(value, list):
            return value
    return []


def _has_more(data: dict) -> bool:
    return bool(data.get("has_more") or data.get("has_next"))


def _next_page_token(data: dict) -> str:
    return str(data.get("page_token") or data.get("next_page_token") or "")


def _paginate(
    client,
    uri: str,
    *,
    paths: dict,
    base_queries=None,
    page_size=500,
    limit=None,
    action="分页读取",
    required_scope: str = _READ_SCOPE_HINT,
) -> list:
    all_items = []
    page_token = ""
    while True:
        queries = list(base_queries or [])
        queries.append(("page_size", str(min(max(int(page_size or 500), 1), 500))))
        if page_token:
            queries.append(("page_token", page_token))
        code, msg, data = _do_request(client, "GET", uri, paths=paths, queries=queries)
        _raise_api_error(action, code, msg, data=data, required_scope=required_scope)
        page_items = _items(data, "items", "records", "tables", "views", "fields")
        all_items.extend(page_items)
        if limit and len(all_items) >= int(limit):
            return all_items[: int(limit)]
        if not _has_more(data):
            return all_items
        page_token = _next_page_token(data)
        if not page_token:
            raise RuntimeError(f"{action}失败：分页响应缺少 page_token。")


def _normalize_app(data: dict, app_token: str) -> dict:
    app = data.get("app") if isinstance(data.get("app"), dict) else data
    return {
        "app_token": app_token,
        "app_name": app.get("name") or app.get("app_name") or "",
        "metadata": app,
        "tables": _items(data, "tables", "items"),
    }


def _normalize_table(table: dict) -> dict:
    return {
        "table_id": str(table.get("table_id") or table.get("id") or ""),
        "table_name": str(table.get("name") or table.get("table_name") or ""),
        "revision": table.get("revision") or table.get("rev"),
        "raw": table,
    }


def _normalize_view(view: dict) -> dict:
    return {
        "view_id": str(view.get("view_id") or view.get("id") or ""),
        "view_name": str(view.get("view_name") or view.get("name") or ""),
        "view_type": view.get("view_type") or view.get("type"),
        "raw": view,
    }


def _normalize_field(field: dict) -> dict:
    property_value = field.get("property") if isinstance(field.get("property"), dict) else {}
    field_type = field.get("type") or field.get("field_type")
    return {
        "field_id": str(field.get("field_id") or field.get("id") or ""),
        "field_name": str(field.get("field_name") or field.get("name") or ""),
        "field_type": field_type,
        "property": property_value,
        "is_primary": bool(field.get("is_primary") or field.get("primary")),
        "is_computed": bool(property_value.get("formula") or property_value.get("lookup") or property_value.get("auto_number")),
        "is_writable": not bool(property_value.get("formula") or property_value.get("lookup") or field.get("is_readonly")),
        "raw": field,
    }


def _field_type_value(field: dict):
    return field.get("field_type")


def _primary_field(fields: list[dict]) -> dict | None:
    return next((field for field in fields if field.get("is_primary")), None) or (fields[0] if fields else None)


def _value_state(fields: dict, field_name: str) -> str:
    if field_name not in fields:
        return "empty"
    return "null" if fields.get(field_name) is None else "present"


def _normalize_record(record: dict, fields_schema: list[dict]) -> dict:
    raw_fields = record.get("fields") if isinstance(record.get("fields"), dict) else {}
    by_name = {}
    by_id = {}
    states = {}
    for field in fields_schema:
        field_id = field.get("field_id") or ""
        field_name = field.get("field_name") or field_id
        value = raw_fields.get(field_name)
        by_name[field_name] = value if field_name in raw_fields else None
        if field_id:
            by_id[field_id] = value if field_name in raw_fields else None
        states[field_name] = _value_state(raw_fields, field_name)
    for key, value in raw_fields.items():
        if key not in by_name:
            by_name[key] = value
            states[key] = "present" if value is not None else "null"
    return {
        "record_id": str(record.get("record_id") or record.get("id") or ""),
        "fields_by_name": by_name,
        "fields_by_id": by_id,
        "field_states": states,
        "raw_fields": raw_fields,
        "raw": record,
    }


def _match_by_name(items: list[dict], name_key: str, target_name: str, not_found_label: str) -> dict:
    target = str(target_name or "").strip().lower()
    for item in items:
        if str(item.get(name_key) or "").strip().lower() == target:
            return item
    raise LookupError(f"{not_found_label}未找到：{target_name}")


def _find_field(fields: list[dict], field_name_or_id: str) -> dict:
    target = str(field_name_or_id or "").strip()
    if not target:
        raise ValueError("需要提供 target_field。")
    for field in fields:
        if str(field.get("field_id") or "") == target:
            return field
    target_lower = target.lower()
    for field in fields:
        if str(field.get("field_name") or "").strip().lower() == target_lower:
            return field
    raise LookupError(f"字段未找到：{field_name_or_id}")


def _is_text_field(field: dict) -> bool:
    field_type = field.get("field_type")
    return field_type in {1, "1", "text", "Text", "多行文本", "单行文本"}


def _is_select_field(field: dict) -> bool:
    field_type = field.get("field_type")
    return field_type in {3, "3", "single_select", "SingleSelect", "单选"}


def _is_multi_select_field(field: dict) -> bool:
    field_type = field.get("field_type")
    return field_type in {4, "4", "multi_select", "MultiSelect", "多选"}


def _is_date_field(field: dict) -> bool:
    field_type = field.get("field_type")
    return field_type in {5, "5", "date", "DateTime", "日期", "日期时间"}


def _is_linked_record_field(field: dict) -> bool:
    field_type = field.get("field_type")
    property_value = field.get("property") if isinstance(field.get("property"), dict) else {}
    return field_type in {21, "21", "duplex_link", "DuplexLink", "relation", "关联", "双向关联"} or any(
        key in property_value for key in ("table_id", "table_id_list", "back_field_id", "back_field_name", "multiple_table")
    )


def _cell_text(value) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    if isinstance(value, (int, float, bool)):
        return str(value)
    if isinstance(value, list):
        parts = []
        for item in value:
            if isinstance(item, dict):
                parts.append(str(item.get("text") or item.get("name") or item.get("email") or item.get("value") or ""))
            else:
                parts.append(_cell_text(item))
        return "".join(parts)
    if isinstance(value, dict):
        return str(value.get("text") or value.get("name") or value.get("value") or value)
    return str(value)


def _normalize_text(value) -> str:
    return re.sub(r"\s+", " ", _cell_text(value).strip()).lower()


def _strip_text(value) -> str:
    return _cell_text(value).strip()


def _hash_json(value) -> str:
    encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def _normalize_conditions(matching_conditions) -> list[dict]:
    if isinstance(matching_conditions, list):
        normalized = []
        for condition in matching_conditions:
            if not isinstance(condition, dict):
                raise ValueError("matching_conditions 列表中的每一项都必须是对象。")
            field = condition.get("field") or condition.get("field_name") or condition.get("field_id")
            operator = condition.get("operator") or condition.get("op") or "equals"
            value = condition.get("value")
            if not field:
                raise ValueError("每个匹配条件都必须包含 field。")
            normalized.append({"field": str(field), "operator": str(operator), "value": value})
        return normalized
    if isinstance(matching_conditions, dict):
        normalized = []
        for field, value in matching_conditions.items():
            operator = "equals"
            expected = value
            if isinstance(value, dict) and len(value) == 1:
                operator, expected = next(iter(value.items()))
            normalized.append({"field": str(field), "operator": str(operator), "value": expected})
        return normalized
    raise ValueError("matching_conditions 必须是对象或对象列表。")


def _condition_matches(record: dict, condition: dict) -> bool:
    fields = record.get("fields_by_name", {})
    field = condition["field"]
    if field in fields:
        value = fields.get(field)
    else:
        value = record.get("fields_by_id", {}).get(field)
    expected = condition.get("value")
    operator = str(condition.get("operator") or "equals").strip().lower()
    if operator in {"equals", "eq", "=", "等于"}:
        return value == expected or _cell_text(value).strip() == _cell_text(expected).strip()
    if operator in {"contains", "包含"}:
        return _cell_text(expected).strip() in _cell_text(value)
    raise ValueError(f"不支持的匹配操作符：{condition.get('operator')}")


def _record_matches(record: dict, conditions: list[dict]) -> bool:
    return all(_condition_matches(record, condition) for condition in conditions)


def _values_equivalent(saved_value, expected_value) -> bool:
    if saved_value == expected_value or _cell_text(saved_value) == str(expected_value):
        return True
    if isinstance(saved_value, list) and isinstance(expected_value, list):
        saved_text = sorted(_cell_text(item) for item in saved_value)
        expected_text = sorted(_cell_text(item) for item in expected_value)
        return saved_text == expected_text
    return False


def _field_by_name(fields: list[dict]) -> dict[str, dict]:
    return {str(field.get("field_name") or ""): field for field in fields if field.get("field_name")}


def _missing_display(value) -> str:
    text = _cell_text(value).strip()
    return text if text else "待确认"


def _parse_meeting_date(meeting_date: str = "") -> date:
    if not meeting_date:
        return date.today()
    text = str(meeting_date).strip()
    for fmt in ("%Y-%m-%d", "%Y/%m/%d"):
        try:
            return datetime.strptime(text[:10], fmt).date()
        except ValueError:
            continue
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).date()
    except ValueError:
        return date.today()


def _date_to_ms(day: date) -> int:
    dt = datetime.combine(day, datetime_time.min).replace(tzinfo=timezone.utc)
    return int(dt.timestamp() * 1000)


def _coerce_date_value(value, *, meeting_date: str = ""):
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return int(value)
    text = str(value).strip()
    if not text or text in {"待确认", "unknown", "Unknown", "TBD", "tbd"}:
        return None
    base = _parse_meeting_date(meeting_date)
    if text == "本周五":
        days_until_friday = (4 - base.weekday()) % 7
        return _date_to_ms(base + timedelta(days=days_until_friday))
    for fmt in ("%Y-%m-%d", "%Y/%m/%d"):
        try:
            return _date_to_ms(datetime.strptime(text[:10], fmt).date())
        except ValueError:
            continue
    return value


def _display_date_value(value, *, meeting_date: str = "") -> str:
    coerced = _coerce_date_value(value, meeting_date=meeting_date)
    if isinstance(coerced, int):
        return datetime.fromtimestamp(coerced / 1000, tz=timezone.utc).date().isoformat()
    return _missing_display(coerced)


def _coerce_field_value(field: dict, value, *, meeting_date: str = ""):
    if value is None:
        return None
    if _is_linked_record_field(field):
        if isinstance(value, list):
            return [str(item.get("record_id") if isinstance(item, dict) else item) for item in value if item]
        if isinstance(value, dict) and value.get("record_id"):
            return [str(value["record_id"])]
        return [str(value)] if str(value).strip() else None
    if _is_multi_select_field(field):
        if isinstance(value, list):
            raw_values = [str(item).strip() for item in value if str(item).strip()]
        else:
            text = str(value).strip()
            raw_values = [text] if text else []
        options = (field.get("property") or {}).get("options")
        if isinstance(options, list) and options:
            allowed = {str(option.get("name") or option.get("text") or option.get("id") or "").strip() for option in options}
            raw_values = [item for item in raw_values if item in allowed]
        return raw_values or None
    if _is_select_field(field):
        text = str(value).strip()
        if not text:
            return None
        options = (field.get("property") or {}).get("options")
        if isinstance(options, list) and options:
            allowed = {str(option.get("name") or option.get("text") or option.get("id") or "").strip() for option in options}
            if text not in allowed:
                return None
        return text
    if _is_date_field(field):
        return _coerce_date_value(value, meeting_date=meeting_date)
    return value


def _build_record_fields(fields: list[dict], values: dict, *, meeting_date: str = "") -> tuple[dict, list[dict]]:
    schema = _field_by_name(fields)
    body = {}
    unsupported = []
    for name, value in (values or {}).items():
        if value is None:
            continue
        field = schema.get(str(name))
        if not field:
            unsupported.append({"field_name": name, "reason": "field_not_found"})
            continue
        if not field.get("is_writable", True):
            unsupported.append({"field_name": name, "reason": "field_not_writable"})
            continue
        coerced = _coerce_field_value(field, value, meeting_date=meeting_date)
        if coerced is not None:
            body[field["field_name"]] = coerced
    return body, unsupported


def _unsupported_required(unsupported: list[dict], required_names: set[str]) -> list[dict]:
    return [
        item for item in unsupported
        if str(item.get("field_name") or "") in required_names
    ]


def _pending_dir() -> Path:
    return get_hermes_home() / "pending" / "feishu_bitable"


def _pending_path(change_id: str) -> Path:
    return _pending_dir() / f"{change_id}.json"


def _state_dir() -> Path:
    return _pending_dir() / "meeting_state"


def _state_path(fingerprint: str) -> Path:
    return _state_dir() / f"{fingerprint}.json"


def _save_pending(record: dict) -> None:
    path = _pending_path(record["change_id"])
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(record, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, path)


def _load_pending(change_id: str) -> dict | None:
    path = _pending_path(change_id)
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def _delete_pending(change_id: str) -> None:
    try:
        _pending_path(change_id).unlink()
    except FileNotFoundError:
        pass


def _load_meeting_state(fingerprint: str) -> dict | None:
    path = _state_path(fingerprint)
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def _save_meeting_state(state: dict) -> None:
    path = _state_path(state["fingerprint"])
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, path)


def _invalidate_related_pending(new_record: dict) -> list[str]:
    removed = []
    directory = _pending_dir()
    if not directory.exists():
        return removed
    for path in directory.glob("fbu_*.json"):
        try:
            existing = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        same_target = all(
            str(existing.get(key) or "") == str(new_record.get(key) or "")
            for key in ("app_token", "table_id", "record_id", "field_name")
        )
        same_actor = (
            not existing.get("user_id")
            or not new_record.get("user_id")
            or str(existing.get("user_id")) == str(new_record.get("user_id"))
        )
        if same_target and same_actor:
            removed.append(str(existing.get("change_id") or path.stem))
            try:
                path.unlink()
            except FileNotFoundError:
                pass
    return removed


def _pending_scope(record: dict) -> dict:
    return {
        "platform": str(record.get("platform") or "feishu"),
        "user_id": str(record.get("user_id") or ""),
        "chat_id": str(record.get("chat_id") or ""),
        "session_id": str(record.get("session_id") or record.get("conversation_id") or ""),
    }


def _scope_matches(record: dict, *, platform: str = "", user_id: str = "", chat_id: str = "", session_id: str = "") -> bool:
    scope = _pending_scope(record)
    expected = {
        "platform": str(platform or "feishu"),
        "user_id": str(user_id or ""),
        "chat_id": str(chat_id or ""),
        "session_id": str(session_id or ""),
    }
    for key, expected_value in expected.items():
        actual_value = scope[key]
        if actual_value and expected_value and actual_value != expected_value:
            return False
        if actual_value and not expected_value:
            return False
        if expected_value and not actual_value:
            return False
    return True


def _invalidate_meeting_pending(new_record: dict) -> list[str]:
    removed = []
    directory = _pending_dir()
    if not directory.exists():
        return removed
    for path in list(directory.glob("fbmw_*.json")) + list(directory.glob("fbm_*.json")) + list(directory.glob("fbmp_*.json")):
        try:
            existing = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if _scope_matches(
            existing,
            platform=str(new_record.get("platform") or "feishu"),
            user_id=str(new_record.get("user_id") or ""),
            chat_id=str(new_record.get("chat_id") or ""),
            session_id=str(new_record.get("session_id") or ""),
        ):
            removed.append(str(existing.get("change_id") or path.stem))
            try:
                path.unlink()
            except FileNotFoundError:
                pass
    return removed


def _latest_meeting_pending(*, platform: str = "feishu", user_id: str = "", chat_id: str = "", session_id: str = "") -> dict | None:
    directory = _pending_dir()
    if not directory.exists():
        return None
    candidates = []
    for path in list(directory.glob("fbmw_*.json")) + list(directory.glob("fbm_*.json")) + list(directory.glob("fbmp_*.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if record.get("kind") not in {"meeting_write", "project_meeting_write"}:
            continue
        if not _scope_matches(record, platform=platform, user_id=user_id, chat_id=chat_id, session_id=session_id):
            continue
        if time.time() > float(record.get("expires_at") or 0):
            continue
        candidates.append(record)
    if not candidates:
        return None
    return max(candidates, key=lambda item: float(item.get("created_at") or 0))


def _validate_pending_actor(record: dict, user_id: str = "", chat_id: str = "", session_id: str = "", platform: str = "feishu") -> str | None:
    if record.get("platform") and str(record.get("platform")) != str(platform or "feishu"):
        return "只能在创建预览的同一平台确认修改。"
    if record.get("user_id") and str(record.get("user_id")) != str(user_id or ""):
        return "只有创建该预览的同一位飞书用户可以确认修改。"
    if record.get("chat_id") and str(record.get("chat_id")) != str(chat_id or ""):
        return "只能在创建预览的同一个聊天中确认修改。"
    if record.get("session_id") and str(record.get("session_id")) != str(session_id or ""):
        return "只能在创建预览的同一个会话中确认修改。"
    if time.time() > float(record.get("expires_at") or 0):
        if record.get("kind") != "meeting_write":
            return "该 Change ID 已过期，请重新生成预览。"
        return "当前没有待确认的修改，请先发送会议内容或重新生成预览。"
    return None


def _client_or_error():
    client = get_client()
    if client is None:
        raise RuntimeError("Feishu 客户端不可用，请确认网关已启动并完成 Feishu 初始化。")
    return client


def _app_token_from_args(args: dict) -> str:
    app_token = str(args.get("app_token") or "").strip()
    if app_token:
        return app_token
    base_url = str(args.get("base_url") or "").strip()
    if base_url:
        return parse_base_url(base_url)["app_token"]
    raise ValueError("需要提供 base_url 或 app_token。")


def bitable_get_app(base_url: str = "", app_token: str = "") -> dict:
    resolved_token = app_token or parse_base_url(base_url)["app_token"]
    client = _client_or_error()
    code, msg, data = _do_request(client, "GET", _APP_URI, paths={"app_token": resolved_token})
    _raise_api_error("读取 Base 元数据", code, msg, data=data, required_scope=_APP_READ_SCOPE_HINT)
    return _normalize_app(data, resolved_token)


def bitable_list_tables(app_token: str) -> list[dict]:
    client = _client_or_error()
    tables = _paginate(
        client,
        _TABLES_URI,
        paths={"app_token": app_token},
        page_size=100,
        action="列出 Base 数据表",
        required_scope=_APP_READ_SCOPE_HINT,
    )
    return [_normalize_table(table) for table in tables]


def bitable_list_views(app_token: str, table_id: str) -> list[dict]:
    client = _client_or_error()
    views = _paginate(
        client,
        _VIEWS_URI,
        paths={"app_token": app_token, "table_id": table_id},
        page_size=100,
        action="列出数据表视图",
        required_scope=_APP_READ_SCOPE_HINT,
    )
    return [_normalize_view(view) for view in views]


def bitable_list_fields(app_token: str, table_id: str, view_id: str = "") -> list[dict]:
    client = _client_or_error()
    queries = [("view_id", view_id)] if view_id else []
    fields = _paginate(
        client,
        _FIELDS_URI,
        paths={"app_token": app_token, "table_id": table_id},
        base_queries=queries,
        page_size=100,
        action="列出字段",
        required_scope=_FIELD_READ_SCOPE_HINT,
    )
    return [_normalize_field(field) for field in fields]


def bitable_list_records(
    app_token: str,
    table_id: str,
    *,
    view_id: str = "",
    filter_value=None,
    page_size: int = 500,
    page_token: str = "",
    limit: int | None = None,
    fields_schema: list[dict] | None = None,
) -> dict:
    client = _client_or_error()
    queries = [("user_id_type", "open_id")]
    if view_id:
        queries.append(("view_id", view_id))
    if filter_value:
        queries.append(("filter", json.dumps(filter_value, ensure_ascii=False) if not isinstance(filter_value, str) else filter_value))
    if page_token:
        queries.append(("page_token", page_token))

    if page_token:
        code, msg, data = _do_request(
            client,
            "GET",
            _RECORDS_URI,
            paths={"app_token": app_token, "table_id": table_id},
            queries=[*queries, ("page_size", str(min(max(int(page_size or 500), 1), 500)))],
        )
        _raise_api_error("读取记录", code, msg, data=data, required_scope=_READ_SCOPE_HINT)
        records = _items(data, "items", "records")
    else:
        records = _paginate(
            client,
            _RECORDS_URI,
            paths={"app_token": app_token, "table_id": table_id},
            base_queries=queries,
            page_size=page_size,
            limit=limit,
            action="读取记录",
        )
        data = {"has_more": False}

    schema = fields_schema or bitable_list_fields(app_token, table_id, view_id)
    normalized = [_normalize_record(record, schema) for record in records]
    return {
        "records": normalized,
        "total_record_count": len(normalized),
        "has_more": _has_more(data),
        "next_page_token": _next_page_token(data),
    }


def bitable_read_table(
    base_url: str,
    *,
    target_table_name: str = "",
    target_view_name: str = "",
    maximum_rows: int | None = None,
) -> dict:
    parsed = parse_base_url(base_url)
    app_token = parsed["app_token"]
    table_id = parsed["table_id"]
    view_id = parsed["view_id"]
    app = bitable_get_app(app_token=app_token)
    table_name = ""
    view_name = ""
    inaccessible = []

    tables = []
    if target_table_name or not table_id:
        tables = bitable_list_tables(app_token)
        table = _match_by_name(tables, "table_name", target_table_name, "数据表") if target_table_name else (tables[0] if tables else None)
        if table is None:
            raise LookupError("数据表未找到：Base 中没有可用数据表。")
        table_id = table["table_id"]
        table_name = table["table_name"]
    else:
        tables = bitable_list_tables(app_token)
        table = next((item for item in tables if item.get("table_id") == table_id), None)
        table_name = (table or {}).get("table_name", "")

    views = []
    if target_view_name or view_id:
        views = bitable_list_views(app_token, table_id)
        if target_view_name:
            view = _match_by_name(views, "view_name", target_view_name, "视图")
            view_id = view["view_id"]
            view_name = view["view_name"]
        elif view_id:
            view = next((item for item in views if item.get("view_id") == view_id), None)
            view_name = (view or {}).get("view_name", "")

    fields = bitable_list_fields(app_token, table_id, view_id)
    if not fields:
        raise PermissionError("字段列表为空：可能缺少多维表格字段读取权限，或受高级权限限制。")
    records_result = bitable_list_records(
        app_token,
        table_id,
        view_id=view_id,
        page_size=500,
        limit=maximum_rows,
        fields_schema=fields,
    )
    records = records_result["records"]
    if not records and maximum_rows is None:
        inaccessible.append({
            "reason": "empty_records",
            "message": "记录列表为空；如果 Base 中确认有数据，可能是高级权限或应用授权范围限制。",
        })

    return {
        "source_base_url": base_url,
        "app_token": app_token,
        "app_name": app.get("app_name", ""),
        "app_metadata": app.get("metadata", {}),
        "table_id": table_id,
        "table_name": table_name,
        "view_id": view_id,
        "view_name": view_name,
        "field_schema": fields,
        "total_record_count": records_result["total_record_count"],
        "records": records,
        "inaccessible_or_unsupported_fields": inaccessible,
        "read_only": True,
    }


def _resolve_table_for_update(
    *,
    base_url: str = "",
    app_token: str = "",
    table_id: str = "",
    table_name: str = "",
    view_id: str = "",
    view_name: str = "",
) -> dict:
    parsed = parse_base_url(base_url) if base_url else {}
    resolved_app_token = app_token or parsed.get("app_token", "")
    resolved_table_id = table_id or parsed.get("table_id", "")
    resolved_view_id = view_id or parsed.get("view_id", "")
    if not resolved_app_token:
        raise ValueError("需要提供 base_url 或 app_token。")

    tables = bitable_list_tables(resolved_app_token)
    resolved_table_name = ""
    if table_name:
        table = _match_by_name(tables, "table_name", table_name, "数据表")
        resolved_table_id = table["table_id"]
        resolved_table_name = table["table_name"]
    elif resolved_table_id:
        table = next((item for item in tables if item.get("table_id") == resolved_table_id), None)
        if table:
            resolved_table_name = table.get("table_name", "")
    else:
        raise ValueError("需要提供 table_name 或 table_id。")

    resolved_view_name = ""
    if view_name or resolved_view_id:
        views = bitable_list_views(resolved_app_token, resolved_table_id)
        if view_name:
            view = _match_by_name(views, "view_name", view_name, "视图")
            resolved_view_id = view["view_id"]
            resolved_view_name = view["view_name"]
        else:
            view = next((item for item in views if item.get("view_id") == resolved_view_id), None)
            resolved_view_name = (view or {}).get("view_name", "")

    return {
        "app_token": resolved_app_token,
        "table_id": resolved_table_id,
        "table_name": resolved_table_name,
        "view_id": resolved_view_id,
        "view_name": resolved_view_name,
    }


def bitable_prepare_record_update(
    *,
    base_url: str = "",
    app_token: str = "",
    table_id: str = "",
    table_name: str = "",
    view_id: str = "",
    view_name: str = "",
    matching_conditions=None,
    target_field: str = "",
    proposed_new_value=None,
    user_id: str = "",
    chat_id: str = "",
) -> dict:
    resolved = _resolve_table_for_update(
        base_url=base_url,
        app_token=app_token,
        table_id=table_id,
        table_name=table_name,
        view_id=view_id,
        view_name=view_name,
    )
    conditions = _normalize_conditions(matching_conditions)
    fields = bitable_list_fields(resolved["app_token"], resolved["table_id"], resolved["view_id"])
    target = _find_field(fields, target_field)
    if not target.get("is_writable", True):
        raise ValueError(f"字段不可写：{target.get('field_name') or target_field}")
    if not _is_text_field(target):
        raise TypeError(f"暂不支持更新该字段类型：{target.get('field_name')} ({target.get('field_type')})。当前仅支持 Text 字段。")

    records_result = bitable_list_records(
        resolved["app_token"],
        resolved["table_id"],
        view_id=resolved["view_id"],
        page_size=500,
        fields_schema=fields,
    )
    matches = [record for record in records_result["records"] if _record_matches(record, conditions)]
    if not matches:
        return {
            "success": False,
            "message": "没有找到符合匹配条件的记录，未生成 Change ID，未写入任何数据。",
            "matching_conditions": conditions,
            "candidate_record_ids": [],
        }
    if len(matches) > 1:
        return {
            "success": False,
            "message": "匹配到多条记录，未生成 Change ID，未写入任何数据。请增加更明确的匹配条件。",
            "matching_conditions": conditions,
            "candidate_record_ids": [record["record_id"] for record in matches],
        }

    record = matches[0]
    field_name = target["field_name"]
    old_value = record.get("fields_by_name", {}).get(field_name)
    change_id = f"fbu_{uuid.uuid4().hex[:12]}"
    now = time.time()
    pending = {
        "change_id": change_id,
        "app_token": resolved["app_token"],
        "base_url": base_url,
        "table_id": resolved["table_id"],
        "table_name": resolved["table_name"],
        "view_id": resolved["view_id"],
        "view_name": resolved["view_name"],
        "record_id": record["record_id"],
        "matching_conditions": conditions,
        "field_id": target.get("field_id", ""),
        "field_name": field_name,
        "field_type": target.get("field_type"),
        "old_value": old_value,
        "proposed_new_value": proposed_new_value,
        "user_id": str(user_id or ""),
        "chat_id": str(chat_id or ""),
        "created_at": now,
        "expires_at": now + _PENDING_TTL_SECONDS,
    }
    with _pending_lock:
        invalidated = _invalidate_related_pending(pending)
        _save_pending(pending)
    return {
        "success": True,
        "message": "以下为预览，尚未修改原多维表格。请发送：确认修改 " + change_id,
        "change_id": change_id,
        "expires_in_seconds": _PENDING_TTL_SECONDS,
        "invalidated_change_ids": invalidated,
        "table_name": resolved["table_name"],
        "table_id": resolved["table_id"],
        "record_id": record["record_id"],
        "matching_conditions": conditions,
        "field_name": field_name,
        "old_value": old_value,
        "proposed_new_value": proposed_new_value,
        "write_performed": False,
    }


def _update_record_field(app_token: str, table_id: str, record_id: str, field_name: str, value) -> None:
    client = _client_or_error()
    code, msg, data = _do_request(
        client,
        "PUT",
        _RECORD_URI,
        paths={"app_token": app_token, "table_id": table_id, "record_id": record_id},
        queries=[("user_id_type", "open_id")],
        body={"fields": {field_name: value}},
    )
    _raise_api_error("更新记录", code, msg, data=data, required_scope=_WRITE_SCOPE_HINT)


def _update_record_fields(app_token: str, table_id: str, record_id: str, fields: dict) -> None:
    if not fields:
        return
    client = _client_or_error()
    code, msg, data = _do_request(
        client,
        "PUT",
        _RECORD_URI,
        paths={"app_token": app_token, "table_id": table_id, "record_id": record_id},
        queries=[("user_id_type", "open_id")],
        body={"fields": fields},
    )
    _raise_api_error("更新记录", code, msg, data=data, required_scope=_WRITE_SCOPE_HINT)


def _create_record(app_token: str, table_id: str, fields: dict) -> dict:
    if not fields:
        raise ValueError("创建记录失败：没有可写字段。")
    client = _client_or_error()
    code, msg, data = _do_request(
        client,
        "POST",
        _RECORDS_URI,
        paths={"app_token": app_token, "table_id": table_id},
        queries=[("user_id_type", "open_id")],
        body={"fields": fields},
    )
    _raise_api_error("创建记录", code, msg, data=data, required_scope=_CREATE_SCOPE_HINT)
    record = data.get("record") if isinstance(data.get("record"), dict) else data
    record_id = str(record.get("record_id") or record.get("id") or "")
    if not record_id:
        raise RuntimeError("创建记录失败：飞书响应缺少 record_id。")
    return {"record_id": record_id, "fields": record.get("fields") if isinstance(record.get("fields"), dict) else fields, "raw": record}


def _create_text_field(app_token: str, table_id: str, field_name: str, *, before_field_id: str = "") -> dict:
    client = _client_or_error()
    body = {"field_name": field_name, "type": 1}
    if before_field_id:
        body["ui_type"] = "Text"
        body["property"] = {"insert_before_field_id": before_field_id}
    code, msg, data = _do_request(
        client,
        "POST",
        _FIELDS_URI,
        paths={"app_token": app_token, "table_id": table_id},
        body=body,
    )
    _raise_api_error("创建字段", code, msg, data=data, required_scope=_FIELD_CREATE_SCOPE_HINT)
    field = data.get("field") if isinstance(data.get("field"), dict) else data
    if not isinstance(field, dict) or not (field.get("field_id") or field.get("id")):
        raise RuntimeError("创建字段失败：飞书响应缺少 field_id。")
    return _normalize_field(field)


def _read_record_from_table(record: dict) -> dict | None:
    fields = bitable_list_fields(record["app_token"], record["table_id"], record.get("view_id", ""))
    records = bitable_list_records(
        record["app_token"],
        record["table_id"],
        view_id=record.get("view_id", ""),
        page_size=500,
        fields_schema=fields,
    )["records"]
    return next((item for item in records if item.get("record_id") == record.get("record_id")), None)


def _resolve_named_table(app_token: str, table_name: str) -> dict:
    tables = bitable_list_tables(app_token)
    return _match_by_name(tables, "table_name", table_name, "数据表")


def _read_table_records_for_workflow(app_token: str, table_id: str, view_id: str = "") -> tuple[list[dict], list[dict]]:
    fields = bitable_list_fields(app_token, table_id, view_id)
    if not fields:
        raise PermissionError("字段列表为空：可能缺少多维表格字段读取权限，或受高级权限限制。")
    records = bitable_list_records(app_token, table_id, view_id=view_id, page_size=500, fields_schema=fields)["records"]
    return fields, records


def _verify_record_fields(record: dict | None, expected_fields: dict) -> list[str]:
    if record is None:
        return ["record_not_readable"]
    saved = record.get("fields_by_name", {})
    missing = []
    for field_name, expected in expected_fields.items():
        if expected is None:
            continue
        if not _values_equivalent(saved.get(field_name), expected):
            missing.append(field_name)
    return missing


def _linked_record_ids(value) -> list[str]:
    if value is None:
        return []
    if isinstance(value, list):
        ids = []
        for item in value:
            if isinstance(item, dict):
                record_id = item.get("record_id") or item.get("id") or item.get("text")
                if record_id:
                    ids.append(str(record_id))
            elif item:
                ids.append(str(item))
        return ids
    if isinstance(value, dict):
        record_id = value.get("record_id") or value.get("id") or value.get("text")
        return [str(record_id)] if record_id else []
    return [str(value)] if str(value).strip() else []


def _date_field_name(meeting_date: str) -> str:
    day = _parse_meeting_date(meeting_date)
    return day.strftime("%d-%b").lstrip("0")


def _plan_date_text_field(fields: list[dict], meeting_date: str) -> tuple[dict, bool, str]:
    target = _date_field_name(meeting_date)
    for field in fields:
        if str(field.get("field_name") or "") == target:
            return field, False, ""
    group_field = next((field for field in fields if str(field.get("field_name") or "") == "分组"), None)
    created = {"field_id": "", "field_name": target, "field_type": 1, "property": {}, "is_writable": True}
    note = "" if group_field else "未找到“分组”字段，日期列已创建但无法定位到其前方。"
    return created, True, note


def _ensure_date_text_field(app_token: str, table_id: str, fields: list[dict], meeting_date: str) -> tuple[dict, bool, str]:
    planned, should_create, note = _plan_date_text_field(fields, meeting_date)
    if not should_create:
        return planned, False, note
    group_field = next((field for field in fields if str(field.get("field_name") or "") == "分组"), None)
    created = _create_text_field(app_token, table_id, planned["field_name"], before_field_id=str((group_field or {}).get("field_id") or ""))
    return created, True, note


def _meeting_fingerprint(*, app_token: str, project_record_id: str, maison: str, project: str, meeting_date: str, meeting_notes: str) -> str:
    return "fbmf_" + _hash_json({
        "app_token": app_token,
        "project_record_id": project_record_id,
        "maison": _normalize_text(maison),
        "project": _normalize_text(project),
        "meeting_date": str(_parse_meeting_date(meeting_date).isoformat()),
        "meeting_notes": _normalize_text(meeting_notes),
    })[:24]


def _dedupe_action_items(action_items: list[dict], *, project_record_id: str, fingerprint: str) -> list[dict]:
    seen = set()
    deduped = []
    for item in action_items or []:
        key = _hash_json({
            "task": _normalize_text(item.get("Task1") or item.get("Task") or ""),
            "owner": _normalize_text(item.get("Owner") or ""),
            "deadline": _normalize_text(item.get("Deadline") or ""),
            "project_record_id": project_record_id,
            "fingerprint": fingerprint,
        })
        if key in seen:
            continue
        seen.add(key)
        normalized = dict(item)
        if "Task1" not in normalized and "Task" in normalized:
            normalized["Task1"] = normalized.pop("Task")
        deduped.append(normalized)
    return deduped


def _find_live_record_by_field(app_token: str, table_id: str, field_name: str, expected_value: str) -> dict | None:
    fields, records = _read_table_records_for_workflow(app_token, table_id)
    if not any(field.get("field_name") == field_name for field in fields):
        return None
    for record in records:
        if _cell_text(record.get("fields_by_name", {}).get(field_name)).strip() == str(expected_value):
            return record
    return None


def _meeting_summary_text(meeting_record_fields: dict, action_items: list[dict]) -> str:
    summary_parts = []
    for key in ("AI Summary", "Meeting Summary", "Summary"):
        if meeting_record_fields.get(key):
            summary_parts.append(_cell_text(meeting_record_fields[key]))
            break
    if action_items:
        summary_parts.append("Action Items:\n" + "\n".join(f"- {_cell_text(item.get('Task1') or item.get('Task'))}" for item in action_items))
    return "\n\n".join(part for part in summary_parts if part)


_PROJECT_MEETING_CONFIRMATIONS = {"确认", "同意", "可以", "写入", "确认写入"}


def _extract_labeled_block(text: str, labels: tuple[str, ...], stop_labels: tuple[str, ...]) -> str:
    label_pattern = "|".join(re.escape(label) for label in labels)
    stop_pattern = "|".join(re.escape(label) for label in stop_labels)
    pattern = re.compile(
        rf"(?:^|\n)\s*(?:{label_pattern})\s*[:：]\s*(.*?)(?=\n\s*(?:{stop_pattern})\s*[:：]|\Z)",
        re.IGNORECASE | re.DOTALL,
    )
    match = pattern.search(text or "")
    return match.group(1).strip() if match else ""


def _parse_action_items(value) -> list[dict]:
    if isinstance(value, list):
        parsed = []
        for item in value:
            if isinstance(item, dict):
                normalized = dict(item)
                if "Task1" not in normalized and "Task" in normalized:
                    normalized["Task1"] = normalized.pop("Task")
                parsed.append(normalized)
        return parsed
    text = str(value or "").strip()
    if not text:
        return []
    parsed = []
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        line = re.sub(r"^\s*(?:[-*]|\d+[.)、])\s*", "", line)
        parts = [part.strip() for part in re.split(r"[|｜]", line)]
        if not parts or not parts[0]:
            continue
        item = {"Task1": parts[0]}
        if len(parts) > 1 and parts[1]:
            item["Owner"] = parts[1]
        if len(parts) > 2 and parts[2]:
            item["Deadline"] = parts[2]
        if len(parts) > 3 and parts[3]:
            item["Status"] = parts[3]
        if len(parts) > 4 and parts[4]:
            item["Priority"] = parts[4]
        parsed.append(item)
    return parsed


def _parse_project_meeting_input(
    *,
    raw_text: str = "",
    maison: str = "",
    project: str = "",
    meeting_notes: str = "",
    risk: str = "",
    latest_progress: str = "",
    status: str = "",
    action_items=None,
    meeting_date: str = "",
) -> dict:
    labels = (
        "Maison", "品牌", "Project", "项目", "分组", "Project Type", "Meeting Notes", "会议记录", "会议内容",
        "Risk", "风险", "最新进展记录", "Latest Progress", "Action Items", "待办事项", "Status", "状态", "Meeting Date", "会议日期",
    )
    parsed = {
        "maison": maison or _extract_labeled_block(raw_text, ("Maison", "品牌"), labels),
        "project": project or _extract_labeled_block(raw_text, ("Project", "项目", "分组", "Project Type"), labels),
        "meeting_notes": meeting_notes or _extract_labeled_block(raw_text, ("Meeting Notes", "会议记录", "会议内容"), labels),
        "risk": risk or _extract_labeled_block(raw_text, ("Risk", "风险"), labels),
        "latest_progress": latest_progress or _extract_labeled_block(raw_text, ("最新进展记录", "Latest Progress"), labels),
        "status": status or _extract_labeled_block(raw_text, ("Status", "状态"), labels),
        "meeting_date": meeting_date or _extract_labeled_block(raw_text, ("Meeting Date", "会议日期"), labels),
        "action_items": _parse_action_items(action_items if action_items is not None else _extract_labeled_block(raw_text, ("Action Items", "待办事项"), labels)),
    }
    if not parsed["meeting_notes"] and raw_text:
        parsed["meeting_notes"] = raw_text.strip()
    return {key: (value.strip() if isinstance(value, str) else value) for key, value in parsed.items()}


def _field_schema_exact(fields: list[dict], required_names: list[str], table_name: str) -> dict[str, dict]:
    schema = {str(field.get("field_name") or "").strip(): field for field in fields}
    missing = [name for name in required_names if name not in schema]
    if missing:
        raise LookupError(f"{table_name} 缺少必需字段：{', '.join(missing)}。")
    return schema


def _project_record_score(record: dict, primary_name: str) -> int:
    fields = record.get("fields_by_name", {})
    score = 0
    if _strip_text(fields.get("Maison")):
        score += 100
    if _strip_text(fields.get("分组")):
        score += 100
    if _strip_text(fields.get(primary_name)) or _strip_text(fields.get("任务描述")):
        score += 25
    for name in ("Risk", "最新进展记录", "Status", "Launch Date", "Action Items", "Meeting Records"):
        if _strip_text(fields.get(name)):
            score += 5
    return score


def _select_project_tracking_record(records: list[dict], fields: list[dict], maison: str, project: str) -> dict:
    primary_field = next((field for field in fields if field.get("field_name") == "任务描述"), None) or _primary_field(fields)
    primary_name = (primary_field or {}).get("field_name") or "任务描述"
    matches = [
        record for record in records
        if _strip_text(record.get("fields_by_name", {}).get("Maison")) == str(maison).strip()
        and _strip_text(record.get("fields_by_name", {}).get("分组")) == str(project).strip()
    ]
    if not matches:
        raise LookupError("未找到 Maison 与 Project 同时匹配的 Project Tracking 记录，请检查项目名称。")
    scored = sorted(matches, key=lambda record: _project_record_score(record, primary_name), reverse=True)
    best_score = _project_record_score(scored[0], primary_name)
    tied = [record for record in scored if _project_record_score(record, primary_name) == best_score]
    if len(tied) > 1 and best_score > 0:
        raise RuntimeError("存在多个无法区分的 Project Tracking 候选记录，请选择后重试。候选记录：" + ", ".join(_strip_text(r.get("fields_by_name", {}).get(primary_name)) or r["record_id"] for r in tied[:2]))
    return scored[0]


def _append_with_date(old_value, new_value: str, meeting_date: str) -> str:
    old_text = _strip_text(old_value)
    new_text = str(new_value or "").strip()
    if not new_text:
        return old_text
    if not old_text:
        return new_text
    if new_text in old_text:
        return old_text
    return f"{old_text}\n\n{_parse_meeting_date(meeting_date).isoformat()}：\n{new_text}"


def _select_value_or_empty(field: dict, value: str):
    if not value:
        return None
    return _coerce_field_value(field, value)


def _project_meeting_fingerprint(*, app_token: str, project_record_id: str, maison: str, project: str, meeting_date: str, meeting_notes: str, action_items: list[dict]) -> str:
    return "fbmp_" + _hash_json({
        "app_token": app_token,
        "project_record_id": project_record_id,
        "maison": _normalize_text(maison),
        "project": _normalize_text(project),
        "meeting_date": _parse_meeting_date(meeting_date).isoformat(),
        "meeting_notes": _normalize_text(meeting_notes),
        "action_items": [
            {
                "task": _normalize_text(item.get("Task1") or ""),
                "owner": _normalize_text(item.get("Owner") or ""),
                "deadline": _normalize_text(item.get("Deadline") or ""),
                "status": _normalize_text(item.get("Status") or ""),
                "priority": _normalize_text(item.get("Priority") or ""),
            }
            for item in action_items
        ],
    })[:24]


def bitable_prepare_meeting_write(
    *,
    base_url: str = "",
    app_token: str = "",
    project: str = "",
    maison: str = "",
    meeting_notes: str = "",
    project_table_name: str = "Project Tracking",
    project_table_id: str = "",
    project_view_id: str = "",
    project_matching_conditions=None,
    project_updates: dict | None = None,
    meeting_records_table_name: str = "Meeting Records",
    action_items_table_name: str = "Action Items",
    meeting_record_fields: dict | None = None,
    action_items: list[dict] | None = None,
    meeting_date: str = "",
    analysis: dict | None = None,
    user_id: str = "",
    chat_id: str = "",
    session_id: str = "",
    platform: str = "feishu",
) -> dict:
    parsed = parse_base_url(base_url) if base_url else {}
    resolved_app_token = app_token or parsed.get("app_token", "")
    if not resolved_app_token:
        raise ValueError("需要提供 base_url 或 app_token。")

    if project_table_id:
        project_table = {"table_id": project_table_id, "table_name": project_table_name or project_table_id}
    else:
        project_table = _resolve_named_table(resolved_app_token, project_table_name)
    meeting_table = _resolve_named_table(resolved_app_token, meeting_records_table_name)
    action_table = _resolve_named_table(resolved_app_token, action_items_table_name)

    project_fields, project_records = _read_table_records_for_workflow(resolved_app_token, project_table["table_id"], project_view_id)
    meeting_fields = bitable_list_fields(resolved_app_token, meeting_table["table_id"])
    action_fields = bitable_list_fields(resolved_app_token, action_table["table_id"])

    analysis = analysis or {}
    if not meeting_date:
        meeting_date = str(analysis.get("meeting_date") or date.today().isoformat())
    if not project:
        project = str(analysis.get("project") or analysis.get("project_group") or "")
    if not maison:
        maison = str(analysis.get("maison") or "")
    if project_matching_conditions is None:
        project_matching_conditions = {}
        if maison:
            project_matching_conditions["Maison"] = {"contains": maison}
        if project:
            project_matching_conditions["分组"] = project
    conditions = _normalize_conditions(project_matching_conditions)
    matches = [record for record in project_records if _record_matches(record, conditions)]
    if not matches:
        return {
            "success": False,
            "message": "没有找到符合匹配条件的 Project Tracking 记录，未生成预览，未写入任何数据。",
            "candidate_record_ids": [],
        }
    if len(matches) > 1:
        return {
            "success": False,
            "message": "匹配到多条 Project Tracking 记录，未生成预览，未写入任何数据。请增加更明确的匹配条件。",
            "candidate_record_ids": [record["record_id"] for record in matches],
        }
    project_record = matches[0]
    primary = _primary_field(project_fields)
    primary_value = project_record.get("fields_by_name", {}).get((primary or {}).get("field_name", ""))
    if not _cell_text(primary_value).strip():
        raise RuntimeError("匹配到的 Project Tracking 记录主字段为空，DuplexLink 会显示“未命名记录”；未写入任何数据。")
    project_display = _cell_text(primary_value).strip()

    inferred_meeting_fields = dict(meeting_record_fields or {})
    if meeting_notes and "Meeting Notes" not in inferred_meeting_fields:
        inferred_meeting_fields["Meeting Notes"] = meeting_notes
    if maison and "Maison" not in inferred_meeting_fields:
        inferred_meeting_fields["Maison"] = maison
    if meeting_date and "Meeting Date" not in inferred_meeting_fields:
        inferred_meeting_fields["Meeting Date"] = meeting_date
    if "Project" not in inferred_meeting_fields:
        inferred_meeting_fields["Project"] = project_record["record_id"]
    if "AI Summary" not in inferred_meeting_fields and analysis.get("ai_summary"):
        inferred_meeting_fields["AI Summary"] = analysis.get("ai_summary")
    if "AI Action Items" not in inferred_meeting_fields and action_items:
        inferred_meeting_fields["AI Action Items"] = "\n".join(f"- {_cell_text(item.get('Task1') or item.get('Task'))}" for item in action_items)

    inferred_project_updates = dict(project_updates or {})
    if analysis.get("latest_progress") and "最新进展记录" not in inferred_project_updates:
        inferred_project_updates["最新进展记录"] = analysis["latest_progress"]
    if analysis.get("status") and "Status" not in inferred_project_updates:
        inferred_project_updates["Status"] = analysis["status"]
    if analysis.get("risk") and "Risk" not in inferred_project_updates:
        inferred_project_updates["Risk"] = analysis["risk"]

    date_field, date_field_created, date_field_note = _plan_date_text_field(project_fields, meeting_date)
    date_note_value = analysis.get("date_note") or analysis.get("latest_progress") or _meeting_summary_text(inferred_meeting_fields, action_items or [])
    if date_note_value:
        inferred_project_updates[date_field["field_name"]] = _cell_text(date_note_value)

    fingerprint = _meeting_fingerprint(
        app_token=resolved_app_token,
        project_record_id=project_record["record_id"],
        maison=maison or project_record.get("fields_by_name", {}).get("Maison"),
        project=project,
        meeting_date=meeting_date,
        meeting_notes=meeting_notes or inferred_meeting_fields.get("Meeting Notes") or json.dumps(inferred_meeting_fields, ensure_ascii=False),
    )

    state = _load_meeting_state(fingerprint)
    if state and state.get("status") == "applied":
        return {
            "success": True,
            "message": "该会议变更已执行，不会重复写入。",
            "already_applied": True,
            "write_performed": False,
            "user_message": "本次会议内容已写入飞书，无需重复执行。",
        }
    for field_name in ("Source Fingerprint", "Meeting Key"):
        live = _find_live_record_by_field(resolved_app_token, meeting_table["table_id"], field_name, fingerprint)
        if live:
            state = {
                "fingerprint": fingerprint,
                "status": "applied",
                "created_record_ids": {"meeting_record_id": live["record_id"], "action_record_ids": []},
                "updated_at": time.time(),
            }
            _save_meeting_state(state)
            return {
                "success": True,
                "message": "该会议变更已执行，不会重复写入。",
                "already_applied": True,
                "write_performed": False,
                "user_message": "本次会议内容已写入飞书，无需重复执行。",
            }

    if any(field.get("field_name") == "Source Fingerprint" for field in meeting_fields):
        inferred_meeting_fields["Source Fingerprint"] = fingerprint
    if any(field.get("field_name") == "Meeting Key" for field in meeting_fields):
        inferred_meeting_fields["Meeting Key"] = fingerprint

    project_body, project_unsupported = _build_record_fields(project_fields + [date_field], inferred_project_updates, meeting_date=meeting_date)
    meeting_body, meeting_unsupported = _build_record_fields(meeting_fields, inferred_meeting_fields, meeting_date=meeting_date)

    prepared_action_items = []
    action_unsupported = []
    normalized_action_items = _dedupe_action_items(action_items or analysis.get("action_items") or [], project_record_id=project_record["record_id"], fingerprint=fingerprint)
    for idx, item in enumerate(normalized_action_items, start=1):
        values = dict(item or {})
        if "Project" not in values:
            values["Project"] = project_record["record_id"]
        if maison and "Maison" not in values:
            values["Maison"] = maison
        values.setdefault("Owner", None)
        values.setdefault("Deadline", None)
        fields_body, unsupported = _build_record_fields(action_fields, values, meeting_date=meeting_date)
        for entry in unsupported:
            action_unsupported.append({"index": idx, **entry})
        preview = {
            "Task1": _missing_display(values.get("Task1")),
            "Project": project_display,
            "Maison": _missing_display(values.get("Maison")),
            "Owner": _missing_display(values.get("Owner")),
            "Deadline": _display_date_value(values.get("Deadline"), meeting_date=meeting_date),
            "Status": _missing_display(values.get("Status")),
            "Priority": _missing_display(values.get("Priority")),
            "Source Meeting": "将在写入时链接到新建 Meeting Records 记录",
        }
        prepared_action_items.append({"input": values, "fields_without_source_meeting": fields_body, "preview": preview})

    if not prepared_action_items:
        raise ValueError("至少需要提供一个 Action Item。")
    if project_unsupported or meeting_unsupported or action_unsupported:
        return {
            "success": False,
            "message": "部分字段不存在或不可写，未生成 Change ID，未写入任何数据。",
            "unsupported_fields": {
                "project_tracking": project_unsupported,
                "meeting_records": meeting_unsupported,
                "action_items": action_unsupported,
            },
        }

    change_id = f"fbm_{uuid.uuid4().hex[:12]}"
    now = time.time()
    pending = {
        "kind": "meeting_write",
        "change_id": change_id,
        "app_token": resolved_app_token,
        "base_url": base_url,
        "project_table": project_table,
        "meeting_table": meeting_table,
        "action_table": action_table,
        "project_view_id": project_view_id,
        "project_record_id": project_record["record_id"],
        "project_matching_conditions": conditions,
        "project_original_fields": project_record.get("fields_by_name", {}),
        "project_updates": project_body,
        "meeting_record_fields": meeting_body,
        "action_items": prepared_action_items,
        "meeting_date": meeting_date,
        "fingerprint": fingerprint,
        "idempotency_status": (state or {}).get("status", "previewed"),
        "created_record_ids": (state or {}).get("created_record_ids", {}),
        "date_field": {"field_name": date_field["field_name"], "field_id": date_field.get("field_id", ""), "created": date_field_created, "note": date_field_note},
        "platform": str(platform or "feishu"),
        "user_id": str(user_id or ""),
        "chat_id": str(chat_id or ""),
        "session_id": str(session_id or ""),
        "created_at": now,
        "expires_at": now + _PENDING_TTL_SECONDS,
    }
    with _pending_lock:
        invalidated = _invalidate_meeting_pending(pending)
        _save_pending(pending)
        if not state:
            _save_meeting_state({
                "fingerprint": fingerprint,
                "status": "previewed",
                "change_id": change_id,
                "created_record_ids": {},
                "created_at": now,
                "updated_at": now,
            })

    meeting_preview_fields = {
        key: value
        for key, value in inferred_meeting_fields.items()
        if key not in {"Source Fingerprint", "Meeting Key"}
    }
    if "Project" in meeting_preview_fields:
        meeting_preview_fields["Project"] = project_display
    date_field_preview = {
        "field_name": pending["date_field"]["field_name"],
        "created": pending["date_field"]["created"],
        "note": pending["date_field"]["note"],
    }

    return {
        "success": True,
        "message": "以下为预览，尚未修改飞书多维表格。\n\n是否确认写入飞书？请回复：确认",
        "user_message": "以下为预览，尚未修改飞书多维表格。\n\n是否确认写入飞书？请回复：确认",
        "expires_in_seconds": _PENDING_TTL_SECONDS,
        "confirmation_required": "确认",
        "internal_preview_replaced": bool(invalidated),
        "project_tracking": {
            "table_name": project_table.get("table_name", ""),
            "record": project_display,
            "updates": project_body,
            "date_field": date_field_preview,
        },
        "meeting_records": {
            "table_name": meeting_table.get("table_name", ""),
            "new_record_fields": meeting_preview_fields,
        },
        "action_items": [item["preview"] for item in prepared_action_items],
        "write_performed": False,
    }


def bitable_apply_meeting_write(
    *,
    change_id: str = "",
    confirmation_text: str = "",
    user_id: str = "",
    chat_id: str = "",
    session_id: str = "",
    platform: str = "feishu",
) -> dict:
    confirmation = str(confirmation_text or "").strip()
    accepted = {"确认", "同意", "可以", "写入", "确认写入"}
    if change_id:
        accepted.add(f"确认 {change_id}")
    if confirmation not in accepted:
        raise ValueError("当前没有有效的明确确认；请在预览后回复：确认")
    pending = _load_pending(change_id) if change_id else _latest_meeting_pending(
        platform=platform,
        user_id=user_id,
        chat_id=chat_id,
        session_id=session_id,
    )
    if not pending or pending.get("kind") != "meeting_write":
        raise LookupError("当前没有待确认的修改，请先发送会议内容或重新生成预览。")
    change_id = pending["change_id"]
    fingerprint = pending.get("fingerprint", "")
    state = _load_meeting_state(fingerprint) if fingerprint else None
    if state and state.get("status") == "applied":
        return {
            "success": True,
            "message": "本次会议内容已写入飞书，无需重复执行。",
            "user_message": "本次会议内容已写入飞书，无需重复执行。",
            "already_applied": True,
            "verified": True,
        }
    actor_error = _validate_pending_actor(pending, user_id, chat_id, session_id, platform)
    if actor_error:
        raise ValueError(actor_error)

    project_probe = {
        "app_token": pending["app_token"],
        "table_id": pending["project_table"]["table_id"],
        "view_id": pending.get("project_view_id", ""),
        "record_id": pending["project_record_id"],
    }
    project_before = _read_record_from_table(project_probe)
    if project_before is None:
        raise LookupError("Project Tracking 目标记录不存在或当前应用无权读取，未写入任何数据。")
    for field_name, old_value in (pending.get("project_original_fields") or {}).items():
        if field_name in (pending.get("project_updates") or {}) and not _values_equivalent(
            project_before.get("fields_by_name", {}).get(field_name),
            old_value,
        ):
            raise RuntimeError("Project Tracking 记录在预览后发生变化，未写入任何数据。请重新生成预览。")

    created_ids = dict((state or {}).get("created_record_ids") or {})
    created_action_records = [
        {"record_id": record_id, "expected_fields": {}}
        for record_id in created_ids.get("action_record_ids", [])
    ]
    if fingerprint:
        _save_meeting_state({
            "fingerprint": fingerprint,
            "status": "applying",
            "change_id": change_id,
            "created_record_ids": created_ids,
            "updated_at": time.time(),
        })
    try:
        meeting_record_id = created_ids.get("meeting_record_id")
        if not meeting_record_id:
            meeting_record = _create_record(
                pending["app_token"],
                pending["meeting_table"]["table_id"],
                pending.get("meeting_record_fields") or {},
            )
            meeting_record_id = meeting_record["record_id"]
            created_ids["meeting_record_id"] = meeting_record_id
            created_ids.setdefault("action_record_ids", [])
            if fingerprint:
                _save_meeting_state({
                    "fingerprint": fingerprint,
                    "status": "applying",
                    "change_id": change_id,
                    "created_record_ids": created_ids,
                    "updated_at": time.time(),
                })
        action_fields = bitable_list_fields(pending["app_token"], pending["action_table"]["table_id"])
        action_schema = _field_by_name(action_fields)
        existing_action_ids = list(created_ids.get("action_record_ids", []))
        for idx, item in enumerate(pending.get("action_items") or []):
            if idx < len(existing_action_ids):
                continue
            body = dict(item.get("fields_without_source_meeting") or {})
            source_field = action_schema.get("Source Meeting")
            if source_field and source_field.get("is_writable", True):
                body["Source Meeting"] = _coerce_field_value(source_field, meeting_record_id, meeting_date=pending.get("meeting_date", ""))
            action_record = _create_record(pending["app_token"], pending["action_table"]["table_id"], body)
            created_action_records.append({"record_id": action_record["record_id"], "expected_fields": body})
            created_ids.setdefault("action_record_ids", []).append(action_record["record_id"])
            if fingerprint:
                _save_meeting_state({
                    "fingerprint": fingerprint,
                    "status": "applying",
                    "change_id": change_id,
                    "created_record_ids": created_ids,
                    "updated_at": time.time(),
                })
        project_fields_for_date = bitable_list_fields(pending["app_token"], pending["project_table"]["table_id"], pending.get("project_view_id", ""))
        if (pending.get("date_field") or {}).get("created"):
            _ensure_date_text_field(
                pending["app_token"],
                pending["project_table"]["table_id"],
                project_fields_for_date,
                pending.get("meeting_date", ""),
            )
        _update_record_fields(
            pending["app_token"],
            pending["project_table"]["table_id"],
            pending["project_record_id"],
            pending.get("project_updates") or {},
        )
        project_fields = bitable_list_fields(pending["app_token"], pending["project_table"]["table_id"], pending.get("project_view_id", ""))
        project_schema = _field_by_name(project_fields)
        project_action_field = project_schema.get("Action Items")
        if project_action_field and project_action_field.get("is_writable", True):
            existing_links = _linked_record_ids(project_before.get("fields_by_name", {}).get("Action Items"))
            merged_links = list(dict.fromkeys([*existing_links, *[item["record_id"] for item in created_action_records]]))
            _update_record_fields(
                pending["app_token"],
                pending["project_table"]["table_id"],
                pending["project_record_id"],
                {"Action Items": _coerce_field_value(project_action_field, merged_links, meeting_date=pending.get("meeting_date", ""))},
            )
        project_meeting_field = project_schema.get("Meeting Records")
        if project_meeting_field and project_meeting_field.get("is_writable", True):
            existing_links = _linked_record_ids(project_before.get("fields_by_name", {}).get("Meeting Records"))
            merged_links = list(dict.fromkeys([*existing_links, meeting_record_id]))
            _update_record_fields(
                pending["app_token"],
                pending["project_table"]["table_id"],
                pending["project_record_id"],
                {"Meeting Records": _coerce_field_value(project_meeting_field, merged_links, meeting_date=pending.get("meeting_date", ""))},
            )
    except PermissionError:
        if fingerprint:
            _save_meeting_state({
                "fingerprint": fingerprint,
                "status": "failed",
                "change_id": change_id,
                "created_record_ids": created_ids,
                "updated_at": time.time(),
            })
        raise
    except Exception as exc:
        if fingerprint:
            _save_meeting_state({
                "fingerprint": fingerprint,
                "status": "failed",
                "change_id": change_id,
                "created_record_ids": created_ids,
                "error": str(exc),
                "updated_at": time.time(),
            })
        raise RuntimeError(f"写入失败：已停止后续操作，未报告完成。原因：{exc}") from exc

    failures = []
    for created in created_action_records:
        probe = {
            "app_token": pending["app_token"],
            "table_id": pending["action_table"]["table_id"],
            "record_id": created["record_id"],
        }
        after = _read_record_from_table(probe)
        missing = _verify_record_fields(after, created["expected_fields"])
        if missing:
            failures.append({"record_id": created["record_id"], "missing_or_mismatched_fields": missing})

    project_after = _read_record_from_table(project_probe)
    if project_after is None:
        failures.append({"record_id": pending["project_record_id"], "missing_or_mismatched_fields": ["project_not_readable_after_write"]})
    if failures:
        if fingerprint:
            _save_meeting_state({
                "fingerprint": fingerprint,
                "status": "failed",
                "change_id": change_id,
                "created_record_ids": created_ids,
                "verification_failures": failures,
                "updated_at": time.time(),
            })
        raise RuntimeError(f"写入后校验失败，不能报告 Action Item 添加成功：{json.dumps(failures, ensure_ascii=False)}")

    if fingerprint:
        _save_meeting_state({
            "fingerprint": fingerprint,
            "status": "applied",
            "change_id": change_id,
            "created_record_ids": created_ids,
            "applied_at": time.time(),
            "updated_at": time.time(),
        })
    return {
        "success": True,
        "message": "已写入飞书。",
        "user_message": "已写入飞书。",
        "project_tracking": {
            "updates": pending.get("project_updates") or {},
        },
        "meeting_records": {
            "created": True,
        },
        "action_items": [
            {"verified": True}
            for item in created_action_records
        ],
        "verified": True,
    }


def bitable_prepare_project_meeting_write(
    *,
    base_url: str = "",
    app_token: str = "",
    raw_text: str = "",
    maison: str = "",
    project: str = "",
    meeting_notes: str = "",
    risk: str = "",
    latest_progress: str = "",
    status: str = "",
    action_items=None,
    meeting_date: str = "",
    user_id: str = "",
    chat_id: str = "",
    session_id: str = "",
    platform: str = "feishu",
) -> dict:
    parsed_url = parse_base_url(base_url) if base_url else {}
    resolved_app_token = app_token or parsed_url.get("app_token", "")
    if not resolved_app_token:
        raise ValueError("需要提供 Feishu Base URL 或已配置的 app_token。")
    parsed = _parse_project_meeting_input(
        raw_text=raw_text,
        maison=maison,
        project=project,
        meeting_notes=meeting_notes,
        risk=risk,
        latest_progress=latest_progress,
        status=status,
        action_items=action_items,
        meeting_date=meeting_date,
    )
    if not parsed["maison"] or not parsed["project"] or not parsed["meeting_notes"]:
        raise ValueError("需要提供 Maison、Project 和 Meeting Notes。")
    if not parsed["meeting_date"]:
        parsed["meeting_date"] = date.today().isoformat()

    project_table = _resolve_named_table(resolved_app_token, "Project Tracking")
    meeting_table = _resolve_named_table(resolved_app_token, "Meeting Records")
    action_table = _resolve_named_table(resolved_app_token, "Action Items")
    project_fields, project_records = _read_table_records_for_workflow(resolved_app_token, project_table["table_id"])
    meeting_fields = bitable_list_fields(resolved_app_token, meeting_table["table_id"])
    action_fields = bitable_list_fields(resolved_app_token, action_table["table_id"])

    project_schema = _field_schema_exact(project_fields, ["任务描述", "Maison", "分组", "Risk", "最新进展记录"], "Project Tracking")
    meeting_schema = _field_schema_exact(
        meeting_fields,
        ["Meeting Date", "Project", "Maison", "Meeting Notes", "AI Summary", "AI Action Items", "Status"],
        "Meeting Records",
    )
    action_schema = _field_schema_exact(
        action_fields,
        ["Task1", "Project", "Maison", "Owner", "Deadline", "Status", "Priority", "Source Meeting"],
        "Action Items",
    )
    project_record = _select_project_tracking_record(project_records, project_fields, parsed["maison"], parsed["project"])
    project_values = project_record.get("fields_by_name", {})
    project_display = _strip_text(project_values.get("任务描述")) or f"{parsed['maison']} {parsed['project']}"
    fingerprint = _project_meeting_fingerprint(
        app_token=resolved_app_token,
        project_record_id=project_record["record_id"],
        maison=parsed["maison"],
        project=parsed["project"],
        meeting_date=parsed["meeting_date"],
        meeting_notes=parsed["meeting_notes"],
        action_items=parsed["action_items"],
    )
    state = _load_meeting_state(fingerprint)
    if state and state.get("status") == "applied":
        return {
            "success": True,
            "message": "本次会议内容已写入飞书，无需重复执行。",
            "user_message": "本次会议内容已写入飞书，无需重复执行。",
            "already_applied": True,
            "write_performed": False,
        }

    risk_new = _append_with_date(project_values.get("Risk"), parsed["risk"], parsed["meeting_date"])
    progress_new = _append_with_date(project_values.get("最新进展记录"), parsed["latest_progress"], parsed["meeting_date"])
    project_updates = {}
    old_new = {}
    if not _strip_text(project_values.get("任务描述")):
        project_updates["任务描述"] = f"{parsed['maison']} {parsed['project']}"
        old_new["任务描述"] = {"old": project_values.get("任务描述"), "new": project_updates["任务描述"]}
    if parsed["risk"] and risk_new != _strip_text(project_values.get("Risk")):
        project_updates["Risk"] = risk_new
        old_new["Risk"] = {"old": project_values.get("Risk"), "new": risk_new}
    if parsed["latest_progress"] and progress_new != _strip_text(project_values.get("最新进展记录")):
        project_updates["最新进展记录"] = progress_new
        old_new["最新进展记录"] = {"old": project_values.get("最新进展记录"), "new": progress_new}
    if parsed["status"] and "Status" in project_schema:
        status_value = _select_value_or_empty(project_schema["Status"], parsed["status"])
        if status_value is not None and not _values_equivalent(project_values.get("Status"), status_value):
            project_updates["Status"] = status_value
            old_new["Status"] = {"old": project_values.get("Status"), "new": status_value}

    meeting_status = _select_value_or_empty(meeting_schema["Status"], "待处理")
    ai_summary_parts = [part for part in (parsed["latest_progress"], parsed["risk"]) if part]
    ai_summary = "\n".join(ai_summary_parts) or parsed["meeting_notes"]
    ai_actions = "\n".join(f"- {item.get('Task1')}" for item in parsed["action_items"])
    meeting_values = {
        "Meeting Date": parsed["meeting_date"],
        "Project": project_record["record_id"],
        "Maison": parsed["maison"],
        "Meeting Notes": parsed["meeting_notes"],
        "AI Summary": ai_summary,
        "AI Action Items": ai_actions,
        "Status": meeting_status,
    }
    meeting_field_names = {field.get("field_name") for field in meeting_fields}
    if "Source Fingerprint" in meeting_field_names:
        meeting_values["Source Fingerprint"] = fingerprint
    if "Meeting Key" in meeting_field_names:
        meeting_values["Meeting Key"] = fingerprint
    meeting_body, meeting_unsupported = _build_record_fields(meeting_fields, meeting_values, meeting_date=parsed["meeting_date"])
    meeting_required = {"Meeting Date", "Project", "Meeting Notes", "AI Summary", "AI Action Items"}
    meeting_required_unsupported = _unsupported_required(meeting_unsupported, meeting_required)
    action_previews = []
    action_bodies_without_source = []
    for item in parsed["action_items"]:
        values = {
            "Task1": item.get("Task1"),
            "Project": project_record["record_id"],
            "Maison": parsed["maison"],
            "Owner": item.get("Owner"),
            "Deadline": item.get("Deadline"),
            "Status": item.get("Status") or "Pending",
            "Priority": item.get("Priority"),
        }
        body, unsupported = _build_record_fields(action_fields, values, meeting_date=parsed["meeting_date"])
        action_required_unsupported = _unsupported_required(unsupported, {"Task1", "Project"})
        if action_required_unsupported:
            field = action_required_unsupported[0]
            raise LookupError(f"Action Items 字段错误：{field.get('field_name')} {field.get('reason')}。")
        action_bodies_without_source.append(body)
        action_previews.append({
            "Task": _missing_display(item.get("Task1")),
            "Owner": _missing_display(item.get("Owner")),
            "Deadline": _display_date_value(item.get("Deadline"), meeting_date=parsed["meeting_date"]),
            "Status": _missing_display(item.get("Status") or "Pending"),
            "Priority": _missing_display(item.get("Priority")),
        })
    if meeting_required_unsupported:
        field = meeting_required_unsupported[0]
        raise LookupError(f"Meeting Records 字段错误：{field.get('field_name')} {field.get('reason')}。")

    now = time.time()
    change_id = f"fbmp_{uuid.uuid4().hex[:12]}"
    pending = {
        "kind": "project_meeting_write",
        "change_id": change_id,
        "app_token": resolved_app_token,
        "base_url": base_url,
        "project_table": project_table,
        "meeting_table": meeting_table,
        "action_table": action_table,
        "project_record_id": project_record["record_id"],
        "project_record_original": project_values,
        "project_display": project_display,
        "maison": parsed["maison"],
        "project": parsed["project"],
        "meeting_date": parsed["meeting_date"],
        "fingerprint": fingerprint,
        "project_updates": project_updates,
        "meeting_record_fields": meeting_body,
        "action_items": [{"fields_without_source_meeting": body, "preview": preview} for body, preview in zip(action_bodies_without_source, action_previews)],
        "skipped_fields": {
            "Meeting Records": [item for item in meeting_unsupported if item not in meeting_required_unsupported],
        },
        "platform": str(platform or "feishu"),
        "user_id": str(user_id or ""),
        "chat_id": str(chat_id or ""),
        "session_id": str(session_id or ""),
        "created_at": now,
        "expires_at": now + _PENDING_TTL_SECONDS,
    }
    with _pending_lock:
        replaced = _invalidate_meeting_pending(pending)
        _save_pending(pending)
        if not state:
            _save_meeting_state({
                "fingerprint": fingerprint,
                "status": "previewed",
                "change_id": change_id,
                "created_record_ids": {},
                "created_at": now,
                "updated_at": now,
            })
    return {
        "success": True,
        "message": "以下为预览，尚未修改飞书多维表格。\n\n是否确认写入飞书？请回复：确认",
        "user_message": "以下为预览，尚未修改飞书多维表格。\n\n是否确认写入飞书？请回复：确认",
        "internal_preview_replaced": bool(replaced),
        "project_tracking": {
            "Maison": parsed["maison"],
            "Project": parsed["project"],
            "record": project_display,
            "updates": old_new,
            "status_changed": "Status" in project_updates,
        },
        "meeting_records": {
            "will_create_rows": 1,
            "Meeting Date": _display_date_value(parsed["meeting_date"], meeting_date=parsed["meeting_date"]),
            "Project": project_display,
            "Maison": parsed["maison"],
            "Meeting Notes": parsed["meeting_notes"],
            "AI Summary": ai_summary,
            "skipped_fields": [item.get("field_name") for item in meeting_unsupported if item not in meeting_required_unsupported],
        },
        "action_items": {
            "will_create_rows": len(action_previews),
            "items": action_previews,
        },
        "write_performed": False,
    }


def bitable_apply_project_meeting_write(
    *,
    confirmation_text: str = "",
    user_id: str = "",
    chat_id: str = "",
    session_id: str = "",
    platform: str = "feishu",
) -> dict:
    if str(confirmation_text or "").strip() not in _PROJECT_MEETING_CONFIRMATIONS:
        raise ValueError("当前没有有效的明确确认；请在预览后回复：确认")
    pending = _latest_meeting_pending(platform=platform, user_id=user_id, chat_id=chat_id, session_id=session_id)
    if not pending or pending.get("kind") != "project_meeting_write":
        raise LookupError("当前没有待确认的修改，请先发送会议内容或重新生成预览。")
    fingerprint = pending["fingerprint"]
    state = _load_meeting_state(fingerprint) or {}
    if state.get("status") == "applied":
        return {"success": True, "message": "本次会议内容已写入飞书，无需重复执行。", "user_message": "本次会议内容已写入飞书，无需重复执行。", "already_applied": True}
    created_ids = dict(state.get("created_record_ids") or {})
    try:
        _save_meeting_state({"fingerprint": fingerprint, "status": "applying", "change_id": pending["change_id"], "created_record_ids": created_ids, "updated_at": time.time()})
        project_probe = {"app_token": pending["app_token"], "table_id": pending["project_table"]["table_id"], "record_id": pending["project_record_id"]}
        project_before = _read_record_from_table(project_probe)
        if project_before is None:
            raise LookupError("Project Tracking 目标记录不存在或当前应用无权读取，未写入任何数据。")

        primary_update = {}
        if "任务描述" in pending.get("project_updates", {}):
            primary_update["任务描述"] = pending["project_updates"]["任务描述"]
            _update_record_fields(pending["app_token"], pending["project_table"]["table_id"], pending["project_record_id"], primary_update)

        meeting_record_id = created_ids.get("meeting_record_id")
        if not meeting_record_id:
            meeting_record = _create_record(pending["app_token"], pending["meeting_table"]["table_id"], pending.get("meeting_record_fields") or {})
            meeting_record_id = meeting_record["record_id"]
            created_ids["meeting_record_id"] = meeting_record_id
            created_ids.setdefault("action_record_ids", [])
            _save_meeting_state({"fingerprint": fingerprint, "status": "applying", "change_id": pending["change_id"], "created_record_ids": created_ids, "updated_at": time.time()})

        action_fields = bitable_list_fields(pending["app_token"], pending["action_table"]["table_id"])
        action_schema = _field_by_name(action_fields)
        existing_count = len(created_ids.get("action_record_ids", []))
        for index, item in enumerate(pending.get("action_items") or []):
            if index < existing_count:
                continue
            body = dict(item.get("fields_without_source_meeting") or {})
            body["Source Meeting"] = _coerce_field_value(action_schema["Source Meeting"], meeting_record_id, meeting_date=pending["meeting_date"])
            action_record = _create_record(pending["app_token"], pending["action_table"]["table_id"], body)
            created_ids.setdefault("action_record_ids", []).append(action_record["record_id"])
            _save_meeting_state({"fingerprint": fingerprint, "status": "applying", "change_id": pending["change_id"], "created_record_ids": created_ids, "updated_at": time.time()})

        remaining_updates = {k: v for k, v in pending.get("project_updates", {}).items() if k != "任务描述"}
        if remaining_updates:
            _update_record_fields(pending["app_token"], pending["project_table"]["table_id"], pending["project_record_id"], remaining_updates)
        project_fields = bitable_list_fields(pending["app_token"], pending["project_table"]["table_id"])
        project_schema = _field_by_name(project_fields)
        reciprocal = {}
        if project_schema.get("Meeting Records") and project_schema["Meeting Records"].get("is_writable", True):
            existing = _linked_record_ids(project_before.get("fields_by_name", {}).get("Meeting Records"))
            reciprocal["Meeting Records"] = _coerce_field_value(project_schema["Meeting Records"], list(dict.fromkeys([*existing, meeting_record_id])))
        if project_schema.get("Action Items") and project_schema["Action Items"].get("is_writable", True):
            existing = _linked_record_ids(project_before.get("fields_by_name", {}).get("Action Items"))
            reciprocal["Action Items"] = _coerce_field_value(project_schema["Action Items"], list(dict.fromkeys([*existing, *created_ids.get("action_record_ids", [])])))
        if reciprocal:
            _update_record_fields(pending["app_token"], pending["project_table"]["table_id"], pending["project_record_id"], reciprocal)

        failures = []
        if _read_record_from_table(project_probe) is None:
            failures.append("Project Tracking verification failed")
        meeting_after = _read_record_from_table({"app_token": pending["app_token"], "table_id": pending["meeting_table"]["table_id"], "record_id": meeting_record_id})
        if meeting_after is None:
            failures.append("Meeting Records verification failed")
        for record_id in created_ids.get("action_record_ids", []):
            action_after = _read_record_from_table({"app_token": pending["app_token"], "table_id": pending["action_table"]["table_id"], "record_id": record_id})
            if action_after is None:
                failures.append("Action Items verification failed")
        if failures:
            raise RuntimeError("写入后校验失败：" + "；".join(failures))
        _save_meeting_state({"fingerprint": fingerprint, "status": "applied", "change_id": pending["change_id"], "created_record_ids": created_ids, "applied_at": time.time(), "updated_at": time.time()})
        return {
            "success": True,
            "message": "已写入飞书。",
            "user_message": "已写入飞书。",
            "meeting_records": {"created": True},
            "action_items": {"created_rows": len(created_ids.get("action_record_ids", []))},
            "project_tracking": {"updated": True},
            "verified": True,
        }
    except PermissionError:
        _save_meeting_state({"fingerprint": fingerprint, "status": "partial_failed", "change_id": pending["change_id"], "created_record_ids": created_ids, "updated_at": time.time()})
        raise
    except Exception as exc:
        _save_meeting_state({"fingerprint": fingerprint, "status": "partial_failed", "change_id": pending["change_id"], "created_record_ids": created_ids, "error": str(exc), "updated_at": time.time()})
        raise


def bitable_apply_record_update(
    *,
    change_id: str,
    confirmation_text: str = "",
    user_id: str = "",
    chat_id: str = "",
) -> dict:
    if not change_id:
        raise ValueError("当前没有有效的修改预览，请先重新生成预览。")
    expected_confirmation = f"确认修改 {change_id}"
    if str(confirmation_text or "").strip() != expected_confirmation:
        raise ValueError(f"请发送明确确认：{expected_confirmation}")

    pending = _load_pending(change_id)
    if not pending:
        raise LookupError("当前没有有效的修改预览，请先重新生成预览。")
    actor_error = _validate_pending_actor(pending, user_id, chat_id)
    if actor_error:
        raise ValueError(actor_error)

    before = _read_record_from_table(pending)
    if before is None:
        raise LookupError("目标记录不存在或当前应用无权读取，未写入任何数据。")
    current_old_value = before.get("fields_by_name", {}).get(pending["field_name"])
    if not _values_equivalent(current_old_value, pending.get("old_value")):
        raise RuntimeError("目标单元格在预览后发生变化，未写入任何数据。请重新生成预览。")

    _update_record_field(
        pending["app_token"],
        pending["table_id"],
        pending["record_id"],
        pending["field_name"],
        pending.get("proposed_new_value"),
    )
    after = _read_record_from_table(pending)
    if after is None:
        raise RuntimeError("写入后无法重新读取目标记录，无法确认保存结果。")
    final_value = after.get("fields_by_name", {}).get(pending["field_name"])
    verified = _values_equivalent(final_value, pending.get("proposed_new_value"))
    if not verified:
        raise RuntimeError("写入后校验失败：飞书返回的最终值与预期不一致。")
    _delete_pending(change_id)
    return {
        "success": True,
        "table_id": pending["table_id"],
        "record_id": pending["record_id"],
        "field_name": pending["field_name"],
        "old_value": pending.get("old_value"),
        "final_saved_value": final_value,
        "verified": True,
    }


